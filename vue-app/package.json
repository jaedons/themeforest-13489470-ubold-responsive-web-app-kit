{
  "name": "ubold-vue-element-plus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
