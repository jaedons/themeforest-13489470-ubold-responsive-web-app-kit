    "@tiptap/vue-3": "3.35.0",
    "chart.js": "4.6.1",
    "element-plus": "2.14.8",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "unplugin-element-plus": "0.11.2",
    "vite": "8.3.8",
